# One key covers both STT (Flux, not built yet) and TTS (Aura-2,
# built now) — no separate cloud-provider account/key needed.
DEEPGRAM_API_KEY=your_deepgram_api_key
SARVAM_API_KEY=your_sarvam_api_key
SARVAM_TTS_SPEAKER=ishita
SARVAM_TTS_PACE=0.95
SARVAM_SILENCE_MS=600
# Aura-2 voice — Thalia is a warm default; try aura-2-luna-en or
# aura-2-stella-en and compare for a hotel-receptionist fit.
DEEPGRAM_TTS_MODEL=aura-2-thalia-en
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-20b

MONGODB_URI=mongodb://USER:PASSWORD@HOST/hotellifyr
MONGODB_DB_NAME=hotellifyr
MONGODB_BOOKINGS_COLLECTION=bookings


# Twilio is no longer used (phone calls go through Plivo); kept for reference.
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_API_KEY_SECRET=your_twilio_api_key_secret
# TWILIO_TWIML_APP_SID=APxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STT_MIN_CONFIDENCE=0.85
MAX_FAILED_VERIFICATIONS=3
HOTEL_INFO_PATH=hotel_info.json

# --- Phone calls: Plivo (plivo_server.py) ---
PLIVO_AUTH_ID=your_plivo_auth_id
PLIVO_AUTH_TOKEN=your_plivo_auth_token
PLIVO_NUMBER=+910000000000
# Public https URL of the server (ngrok URL locally, your domain on AWS)
PUBLIC_BASE_URL=https://voice.hotellifyr.com
# Number a "transfer to a human" dials (E.164, e.g. +919800000000)
HUMAN_AGENT_NUMBER=+919800000000
PHONE_STT_LANG=auto